# Copy this file to .env and fill in the values after the equals signs.
# .env is in .gitignore and must never be committed.
MODEL_API_KEY=

# Google (Vertex AI). Sign-in is gcloud application-default login, so no key here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.8-flash
# Per million tokens; introductory rate through Dec 31 2026, then 1.50 / 7.50.
# gemini-2.5-flash was retired on Vertex Oct 20 2026.
GOOGLE_PRICE_IN_PER_M=0.75
GOOGLE_PRICE_AUDIO_IN_PER_M=0.75
GOOGLE_PRICE_OUT_PER_M=3.75
