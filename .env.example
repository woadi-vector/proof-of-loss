# Copy this file to .env and fill in the values after the equals signs.
# .env is in .gitignore and must never be committed.
MODEL_API_KEY=

# Google (Vertex AI). Sign-in is gcloud application-default login, so no key here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_MODEL=gemini-2.5-flash
# Per million tokens; confirm on the Vertex pricing page when the model changes.
GOOGLE_PRICE_IN_PER_M=0.30
GOOGLE_PRICE_AUDIO_IN_PER_M=1.00
GOOGLE_PRICE_OUT_PER_M=2.50
